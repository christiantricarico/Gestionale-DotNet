@implements IDialogContentComponent<DialogContent>

@inject IDialogService DialogService

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            @Dialog.Instance.Parameters.Title
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    @if (Model is not null)
    {
        <EditForm EditContext="EditContext" FormName="edit-invoice-form">
            <DataAnnotationsValidator />
            <FluentGrid Spacing="1">
                <FluentGridItem xs="12" sm="3">
                    <FluentNumberField @bind-Value="Model.Number" Name="@nameof(InvoiceEditModel.Number)" Label="Numero"
                                       Autofocus="true" Required="true" Style="width: 100%" HideStep="true" Min="1" />
                    <FluentValidationMessage For="@(() => Model.Number)" />
                </FluentGridItem>
                <FluentGridItem xs="12" sm="3">
                    <FluentDatePicker @bind-Value="Model.DateWithTime" Name="@nameof(InvoiceEditModel.DateWithTime)" Label="Data"
                                      Required="true" Style="width: 100%" />
                    <FluentValidationMessage For="@(() => Model.DateWithTime)" />
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6">
                    <FluentCombobox Items=@Customers
                                    TOption="CustomerViewModel"
                                    SelectedOption="SelectedCustomer"
                                    SelectedOptionChanged="o => SelectedCustomerChanged(o)"
                                    Required="true"
                                    OptionText="@(c => c?.Name)"
                                    Label="Cliente" Height="200px" Width="100%"
                                    Autocomplete="ComboboxAutocomplete.Both" />
                    <FluentValidationMessage For="@(() => Model.CustomerId)" />
                </FluentGridItem>
                <FluentGridItem xs="12">
                    <FluentButton IconStart="@(new Icons.Regular.Size24.Add())" OnClick="AddRowClick">
                        Aggiungi riga
                    </FluentButton>
                </FluentGridItem>
            </FluentGrid>
            <FluentStack Orientation="Orientation.Vertical" Style="margin-top: 10px; width: 100%;">
                @foreach (var row in Model.Rows.Where(r => r.InputStatus != 3))
                {
                    <FluentCard MinimalStyle="true" Style="width: 100%;">
                        <FluentGrid Spacing="1" Style="padding: 8px;">
                            <FluentGridItem xs="12" lg="4">
                                <div class="invoice-row-field">
                                    <strong>Descrizione:</strong>
                                    <span>@row.Description</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" lg="2">
                                <div class="invoice-row-field">
                                    <strong>Aliq.Iva:</strong>
                                    <span>@row.TaxRateName</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" lg="2">
                                <div class="invoice-row-field">
                                    <strong>Um:</strong>
                                    <span>@row.MeasurementUnitName</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" lg="1">
                                <div class="invoice-row-field">
                                    <strong>Quantità:</strong>
                                    <span>@row.Quantity.ToString("N2")</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" lg="1">
                                <div class="invoice-row-field">
                                    <strong>Prezzo:</strong>
                                    <span>@row.UnitPrice.ToString("C")</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" lg="1">
                                <div class="invoice-row-field">
                                    <strong>Totale:</strong>
                                    <span>@row.TotalAmount.ToString("C")</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="12" lg="1" Style="display: flex; justify-content: flex-end; align-items: center; gap: 2px;">
                                <FluentButton aria-label="Modifica" IconEnd="@(new Icons.Regular.Size16.Edit())" OnClick="@(() => EditRowClick(row))" />
                                <FluentButton aria-label="Elimina" IconEnd="@(new Icons.Regular.Size16.Delete())" OnClick="@(() => DeleteRowClick(row))" />
                            </FluentGridItem>
                        </FluentGrid>
                    </FluentCard>
                }
            </FluentStack>

            @if (ExemptVatTotal > StampDutyThreshold)
            {
                <FluentDivider Style="margin-top: 10px;" />
                <FluentStack Orientation="Orientation.Vertical" Style="margin-top: 10px; padding: 8px; background: var(--neutral-layer-2); border-radius: 4px;">
                    <FluentLabel Typo="Typography.Subject">
                        Imposta di bollo (€2,00)
                    </FluentLabel>
                    <FluentLabel>
                        La fattura contiene importi esenti IVA superiori a €77,47. È necessario applicare l'imposta di bollo virtuale di €2,00.
                    </FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <FluentCheckbox @bind-Value="StampDutyEnabled" Label="Applica imposta di bollo" />
                    </FluentStack>
                    @if (StampDutyEnabled)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px;">
                            <FluentRadioGroup @bind-Value="Model.StampDutyChargedToCustomer" Name="stampDutyCharge" Label="A carico di:">
                                <FluentRadio Value="false">Emittente</FluentRadio>
                                <FluentRadio Value="true">Cliente</FluentRadio>
                            </FluentRadioGroup>
                        </FluentStack>
                    }
                </FluentStack>
            }

        </EditForm>
    }
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@SaveAsync">
        Salva
    </FluentButton>
</FluentDialogFooter>

<style>
    .invoice-row-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .invoice-row-field strong {
            font-size: 0.875rem;
            color: var(--neutral-foreground-rest);
        }

        .invoice-row-field span {
            font-size: 1rem;
        }
</style>

@code {

    [Inject]
    private IHttpClientFactory HttpClientFactory { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    [Parameter]
    public DialogContent Content { get; set; } = default!;

    private HttpClient HttpClient => HttpClientFactory.CreateApiClientVs();
    private InvoiceEditModel Model { get; set; } = default!;
    private EditContext EditContext { get; set; } = default!;

    IEnumerable<CustomerViewModel>? Customers;
    CustomerViewModel? SelectedCustomer;

    private const decimal StampDutyValue = 2.00m;
    private const decimal StampDutyThreshold = 77.47m;

    private decimal ExemptVatTotal =>
        Model?.Rows
            .Where(r => r.InputStatus != 3 && r.TaxRateValue == 0)
            .Sum(r => r.TotalAmount) ?? 0m;

    private bool StampDutyEnabled
    {
        get => Model?.StampDutyAmount.HasValue ?? false;
        set
        {
            if (Model is null)
                return;

            Model.StampDutyAmount = value ? StampDutyValue : null;
            if (!value)
                Model.StampDutyChargedToCustomer = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Content.Id == 0)
        {
            var lastNumber = await HttpClient.GetFromJsonAsync<int>("invoices/last-number");
            Model = new InvoiceEditModel() { Number = lastNumber + 1 };
        }
        else
        {
            string invoiceUri = $"invoices/{Content.Id}";
            Model = await HttpClient.GetFromJsonAsync<InvoiceEditModel>(invoiceUri) ?? new();
            Model.DateWithTime = Model.Date.ToDateTime(TimeOnly.MinValue);
        }

        EditContext = new EditContext(Model);

        string customersUri = "customers";
        Customers = await HttpClient.GetFromJsonAsync<IEnumerable<CustomerViewModel>>(customersUri)
            ?? Enumerable.Empty<CustomerViewModel>();

        if (Model.CustomerId.HasValue)
            SelectedCustomer = Customers.SingleOrDefault(c => c.Id == Model.CustomerId);
    }

    private void SelectedCustomerChanged(CustomerViewModel? customer)
    {
        SelectedCustomer = customer;
        Model.CustomerId = customer?.Id;
    }

    private async Task SaveAsync()
    {
        Model.Date = DateOnly.FromDateTime(Model.DateWithTime ?? DateTime.MinValue);

        if (ExemptVatTotal <= StampDutyThreshold)
        {
            Model.StampDutyAmount = null;
            Model.StampDutyChargedToCustomer = false;
        }

        if (EditContext.Validate())
        {
            string uri = "invoices";
            if (!Model.Id.HasValue)
                await HttpClient.PostAsJsonAsync<InvoiceEditModel>(uri, Model);
            else
                await HttpClient.PutAsJsonAsync<InvoiceEditModel>(uri, Model);

            await Dialog.CloseAsync(Model);
        }
    }

    private async Task AddRowClick(MouseEventArgs ea)
    {
        InvoiceRowEditModel content = new();
        DialogParameters parameters = new()
        {
            Title = $"Creazione riga fattura",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = false
        };

        var dialog = await DialogService.ShowDialogAsync<InvoiceRowEditDialog>(content, parameters);
        var result = await dialog.Result;
        if (!result.Cancelled)
        {
            content.InputStatus = 1; // added
            Model.Rows.Add(content);
        }
    }

    private async Task EditRowClick(InvoiceRowEditModel context)
    {
        DialogParameters parameters = new()
        {
            Title = $"Modifica riga fattura",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = false
        };

        var dialog = await DialogService.ShowDialogAsync<InvoiceRowEditDialog>(context, parameters);
        var result = await dialog.Result;
        if (!result.Cancelled)
        {
            if (context.InputStatus == 0)
                context.InputStatus = 2; // updated
        }
    }

    private async Task DeleteRowClick(InvoiceRowEditModel context)
    {
        var dialog = await DialogService.ShowConfirmationAsync("Sei sicuro di voler eliminare questo elemento?", "Sì", "No", "Eliminazione");
        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        context.InputStatus = 3; // deleted
    }
}
