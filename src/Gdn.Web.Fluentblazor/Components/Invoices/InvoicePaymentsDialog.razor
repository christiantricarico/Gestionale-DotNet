@implements IDialogContentComponent<InvoiceViewModel>
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center" Style="gap: 12px; width: 100%;">
        <FluentIcon Value="@(new Icons.Regular.Size24.Money())" />
        <FluentStack Orientation="Orientation.Vertical" Style="flex: 1; gap: 2px;">
            <FluentLabel Typo="Typography.PaneHeader">
                Fattura @Content.Number &mdash; @Content.CustomerName
            </FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                @Content.Date.ToString("d")
            </FluentLabel>
        </FluentStack>
        <FluentBadge Appearance="@GetStatusAppearance(PaymentStatus)">@PaymentStatus</FluentBadge>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    @if (IsLoading)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 32px;">
            <FluentProgressRing />
        </FluentStack>
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                     Style="margin-bottom: 12px; gap: 8px;">
            <FluentLabel Typo="Typography.Subject" Style="flex: 1;">Scadenze</FluentLabel>
            @if (Dues.Any(d => !d.IsPaid))
            {
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size16.Add())"
                              OnClick="@RegisterPaymentClickAsync">
                    Registra pagamento
                </FluentButton>
            }
        </FluentStack>

        <FluentStack Orientation="Orientation.Vertical" Style="width: 100%; gap: 6px;">
            @foreach (var due in Dues)
            {
                <FluentCard MinimalStyle="true" Style="width: 100%;">
                    <FluentGrid Spacing="1" Style="padding: 8px; align-items: center;">
                        <FluentGridItem xs="6" sm="3">
                            <div class="pf-field">
                                <span class="pf-label">Scadenza</span>
                                <span>@due.Date.ToString("d")</span>
                            </div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="2">
                            <div class="pf-field">
                                <span class="pf-label">Importo</span>
                                <span>@due.Amount.ToString("C2")</span>
                            </div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="2">
                            <div class="pf-field">
                                <span class="pf-label">Pagato</span>
                                <span>@due.PaidAmount.ToString("C2")</span>
                            </div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="2">
                            <div class="pf-field">
                                <span class="pf-label">Residuo</span>
                                <strong>@((due.Amount - due.PaidAmount).ToString("C2"))</strong>
                            </div>
                        </FluentGridItem>
                        <FluentGridItem xs="12" sm="3">
                            <FluentBadge Appearance="@GetStatusAppearance(due.Status)">@due.Status</FluentBadge>
                        </FluentGridItem>
                    </FluentGrid>
                </FluentCard>
            }
        </FluentStack>

        <FluentDivider Style="margin: 16px 0;" />

        <FluentLabel Typo="Typography.Subject" Style="margin-bottom: 8px; display: block;">
            Pagamenti registrati
        </FluentLabel>

        @if (Payments.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">
                Nessun pagamento registrato per questa fattura.
            </FluentMessageBar>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" Style="width: 100%; gap: 6px;">
                @foreach (var payment in Payments)
                {
                    <FluentCard MinimalStyle="true" Style="width: 100%;">
                        <FluentGrid Spacing="1" Style="padding: 8px; align-items: center;">
                            <FluentGridItem xs="6" sm="2">
                                <div class="pf-field">
                                    <span class="pf-label">Data</span>
                                    <span>@payment.Date.ToString("d")</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" sm="2">
                                <div class="pf-field">
                                    <span class="pf-label">Importo</span>
                                    <span>@payment.Amount.ToString("C2")</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="6" sm="3">
                                <div class="pf-field">
                                    <span class="pf-label">Metodo</span>
                                    <span>@(payment.PaymentMethodName ?? "—")</span>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="12" sm="4">
                                <div class="pf-field">
                                    <span class="pf-label">Allocazioni</span>
                                    <FluentStack Orientation="Orientation.Horizontal"
                                                 Style="flex-wrap: wrap; gap: 4px; margin-top: 2px;">
                                        @foreach (var a in payment.Allocations)
                                        {
                                            <FluentBadge Appearance="Appearance.Neutral">
                                                Sc. @a.DueDate.ToString("dd/MM") &mdash; @a.AllocationAmount.ToString("C2")
                                            </FluentBadge>
                                        }
                                    </FluentStack>
                                </div>
                            </FluentGridItem>
                            <FluentGridItem xs="12" sm="1" Style="display: flex; justify-content: flex-end;">
                                <FluentButton aria-label="Elimina"
                                              IconEnd="@(new Icons.Regular.Size16.Delete())"
                                              OnClick="@(() => DeletePaymentClickAsync(payment))" />
                            </FluentGridItem>
                        </FluentGrid>
                    </FluentCard>
                }
            </FluentStack>
        }
    }
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton OnClick="@(() => Dialog.CloseAsync(_hasChanges))">Chiudi</FluentButton>
</FluentDialogFooter>

<style>
    .pf-field { display: flex; flex-direction: column; gap: 2px; }
    .pf-label { font-size: 0.8rem; color: var(--neutral-foreground-hint); }
</style>

@code {
    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    [Parameter] public InvoiceViewModel Content { get; set; } = default!;

    private HttpClient HttpClient => HttpClientFactory.CreateApiClientVs();
    private bool IsLoading = true;
    private bool _hasChanges;
    private List<InvoiceDueViewModel> Dues { get; set; } = [];
    private List<PaymentHistoryViewModel> Payments { get; set; } = [];
    private string PaymentStatus { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();

        var invoiceDetail = await HttpClient.GetFromJsonAsync<InvoiceEditModel>($"invoices/{Content.Id}");

        Dues = invoiceDetail?.Dues
            .Select(d => new InvoiceDueViewModel
            {
                Id = d.Id!.Value,
                Date = d.Date,
                Amount = d.Amount,
                PaidAmount = d.PaidAmount,
                IsPaid = d.IsPaid
            })
            .OrderBy(d => d.Date)
            .ToList() ?? [];

        Payments = await HttpClient.GetFromJsonAsync<List<PaymentHistoryViewModel>>($"invoices/{Content.Id}/payments")
            ?? [];

        PaymentStatus = Dues switch
        {
            [] => "Non pagata",
            _ when Dues.All(d => d.IsPaid) => "Pagata",
            _ when Dues.Any(d => d.PaidAmount > 0) => "Parzialmente pagata",
            _ => "Non pagata"
        };

        IsLoading = false;
    }

    private async Task RegisterPaymentClickAsync()
    {
        var invoiceForPayment = await HttpClient.GetFromJsonAsync<InvoiceEditModel>($"invoices/{Content.Id}");
        if (invoiceForPayment is null)
            return;

        var parameters = new DialogParameters
        {
            Title = $"Registra pagamento — Fattura {Content.Number}",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = false,
            Width = "480px"
        };

        var dlg = await DialogService.ShowDialogAsync<PaymentDialog>(invoiceForPayment, parameters);
        if (!(await dlg.Result).Cancelled)
        {
            _hasChanges = true;
            await LoadDataAsync();
        }
    }

    private async Task DeletePaymentClickAsync(PaymentHistoryViewModel payment)
    {
        var confirm = await DialogService.ShowConfirmationAsync(
            "Sei sicuro di voler eliminare questo pagamento?", "Sì", "No", "Eliminazione");
        if ((await confirm.Result).Cancelled)
            return;

        var response = await HttpClient.DeleteAsync($"payments/{payment.Id}");
        if (!response.IsSuccessStatusCode)
        {
            await DialogService.ShowResponseErrorAsync(response);
            return;
        }

        _hasChanges = true;
        await LoadDataAsync();
    }

    private static Appearance GetStatusAppearance(string status) => status switch
    {
        "Pagata" => Appearance.Accent,
        "Parzialmente pagata" => Appearance.Neutral,
        _ => Appearance.Lightweight
    };
}
