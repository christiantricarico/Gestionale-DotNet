@page "/invoices"

@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject IJSRuntime JS

<h3>Fatture</h3>

@if (isLoading)
{
    <FluentProgressRing />
}
else if (invoices != null)
{
    <FluentButton OnClick="@CreateButtonClick">Nuova fattura</FluentButton>
    <FluentStack Orientation="Orientation.Vertical" Style="margin-top: 10px; width: 100%;">
        @foreach (var invoice in invoices)
        {
            <FluentCard MinimalStyle="true" Style="width: 100%;">
                <FluentGrid Spacing="1" Style="padding: 8px;">
                    <FluentGridItem xs="6" lg="2">
                        <div class="invoice-row-field">
                            <strong>Numero:</strong>
                            <span>@invoice.Number</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="6" lg="2">
                        <div class="invoice-row-field">
                            <strong>Data:</strong>
                            <span>@invoice.Date.ToString("d")</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" lg="4">
                        <div class="invoice-row-field">
                            <strong>Cliente:</strong>
                            <span>@invoice.CustomerName</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" lg="2">
                        <div class="invoice-row-field">
                            <strong>Pagamento:</strong>
                            <FluentBadge Appearance="@GetPaymentStatusAppearance(invoice.PaymentStatus)">
                                @invoice.PaymentStatus
                            </FluentBadge>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" lg="2" Style="display: flex; justify-content: flex-end; align-items: center; gap: 2px;">
                        <FluentButton aria-label="Pagamenti" IconEnd="@(new Icons.Regular.Size16.Money())" OnClick="@(() => PaymentsButtonClick(invoice))" />
                        <FluentButton aria-label="Stampa" IconEnd="@(new Icons.Regular.Size16.Print())" OnClick="@(() => PrintButtonClick(invoice))" />
                        <FluentButton aria-label="Xml" IconEnd="@(new Icons.Regular.Size16.ArrowDownload())" OnClick="@(() => DownloadButtonClick(invoice))" />
                        <FluentButton aria-label="Modifica" IconEnd="@(new Icons.Regular.Size16.Edit())" OnClick="@(() => EditButtonClick(invoice))" />
                        <FluentButton aria-label="Elimina" IconEnd="@(new Icons.Regular.Size16.Delete())" OnClick="@(() => DeleteButtonClick(invoice))" />
                    </FluentGridItem>
                </FluentGrid>
            </FluentCard>
        }
    </FluentStack>
}

<style>
    .invoice-row-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .invoice-row-field strong {
            font-size: 0.875rem;
            color: var(--neutral-foreground-rest);
        }

        .invoice-row-field span {
            font-size: 1rem;
        }
</style>

@code {

    private HttpClient HttpClient => HttpClientFactory.CreateApiClientVs();
    private bool isLoading = true;
    IEnumerable<InvoiceViewModel>? invoices;

    private static Appearance GetPaymentStatusAppearance(string status) => status switch
    {
        "Pagata" => Appearance.Accent,
        "Parzialmente pagata" => Appearance.Neutral,
        _ => Appearance.Lightweight
    };

    private async Task ReloadGrid()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            string uri = "invoices";
            invoices = await HttpClient.GetFromJsonAsync<IEnumerable<InvoiceViewModel>>(uri);
        }
        catch (HttpRequestException)
        {
            await DialogService.ShowErrorAsync("Errore durante il caricamento dei dati. Riprova.");
            invoices = Array.Empty<InvoiceViewModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadGrid();
    }

    private async Task CreateButtonClick()
    {
        DialogContent content = new();
        DialogParameters parameters = new()
        {
            Title = $"Creazione Fattura",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            Width = "90%",
            TrapFocus = false // avoid not working focus when multiple dialogs are opened
        };

        var dialog = await DialogService.ShowDialogAsync<InvoiceEditDialog>(content, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
            await ReloadGrid();
    }

    private async Task PaymentsButtonClick(InvoiceViewModel context)
    {
        var parameters = new DialogParameters
        {
            Title = $"Pagamenti — Fattura {context.Number}",
            PreventDismissOnOverlayClick = false,
            PreventScroll = true,
            Width = "800px",
            TrapFocus = false
        };

        var dialog = await DialogService.ShowDialogAsync<InvoicePaymentsDialog>(context, parameters);
        var result = await dialog.Result;
        if (!result.Cancelled)
            await ReloadGrid();
    }

    private async Task PrintButtonClick(InvoiceViewModel context)
    {
        string uri = $"invoices/pdf/{context.Id}";
        var response = await HttpClient.GetAsync(uri);
        if (!response.IsSuccessStatusCode)
        {
            await DialogService.ShowResponseErrorAsync(response);
            return;
        }

        var fileStream = await response.Content.ReadAsStreamAsync();
        using var streamRef = new DotNetStreamReference(fileStream);
        await JS.InvokeVoidAsync("openPdfFromStream", streamRef);
    }

    private async Task DownloadButtonClick(InvoiceViewModel context)
    {
        string uri = $"invoices/xml/{context.Id}";
        HttpResponseMessage responseMessage = await HttpClient.GetAsync(uri);
        if (responseMessage.IsSuccessStatusCode)
        {
            var fileName = responseMessage.Content.Headers.ContentDisposition?.FileName?.Trim('"');
            var fileStream = await responseMessage.Content.ReadAsStreamAsync();
            using var streamRef = new DotNetStreamReference(stream: fileStream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        else
            await DialogService.ShowResponseErrorAsync(responseMessage);
    }

    private async Task EditButtonClick(InvoiceViewModel context)
    {
        DialogContent content = new() { Id = context.Id };
        DialogParameters parameters = new()
        {
            Title = $"Modifica Fattura",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            Width = "90%",
            TrapFocus = false // avoid not working focus when multiple dialogs are opened
        };

        var dialog = await DialogService.ShowDialogAsync<InvoiceEditDialog>(content, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
            await ReloadGrid();
    }

    private async Task DeleteButtonClick(InvoiceViewModel context)
    {
        var dialog = await DialogService.ShowConfirmationAsync("Sei sicuro di voler eliminare questo elemento?", "Sì", "No", "Eliminazione");
        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        string uri = $"invoices/{context.Id}";
        var response = await HttpClient.DeleteAsync(uri);
        if (!response.IsSuccessStatusCode)
        {
            await DialogService.ShowResponseErrorAsync(response);
            return;
        }

        await ReloadGrid();
    }
}
