@page "/measurementunits"

@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService

<h3>Unità di misura</h3>

@if (isLoading)
{
    <FluentProgressRing />
}
else if (measurementUnits != null)
{
    <FluentButton OnClick="@CreateButtonClick">Nuova Unità di misura</FluentButton>
    <FluentStack Orientation="Orientation.Vertical" Style="margin-top: 10px; width: 100%;">
        @foreach (var measurementUnit in measurementUnits)
        {
            <FluentCard MinimalStyle="true" Style="width: 100%;">
                <FluentGrid Spacing="1" Style="padding: 8px;">
                    <FluentGridItem xs="6" lg="2">
                        <div class="measurementunit-row-field">
                            <strong>Codice:</strong>
                            <span>@measurementUnit.Code</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="6" lg="3">
                        <div class="measurementunit-row-field">
                            <strong>Nome:</strong>
                            <span>@measurementUnit.Name</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" lg="4">
                        <div class="measurementunit-row-field">
                            <strong>Descrizione:</strong>
                            <span>@(measurementUnit.Description)</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" lg="3" Style="display: flex; justify-content: flex-end; align-items: center; gap: 2px;">
                        <FluentButton aria-label="Modifica" IconEnd="@(new Icons.Regular.Size16.Edit())" OnClick="@(() => EditButtonClick(measurementUnit))" />
                        <FluentButton aria-label="Elimina" IconEnd="@(new Icons.Regular.Size16.Delete())" OnClick="@(() => DeleteButtonClick(measurementUnit))" />
                    </FluentGridItem>
                </FluentGrid>
            </FluentCard>
        }
    </FluentStack>
}

<style>
    .measurementunit-row-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .measurementunit-row-field strong {
            font-size: 0.875rem;
            color: var(--neutral-foreground-rest);
        }

        .measurementunit-row-field span {
            font-size: 1rem;
        }
</style>

@code {

    private HttpClient HttpClient => HttpClientFactory.CreateApiClientVs();
    private bool isLoading = true;
    IEnumerable<MeasurementUnitViewModel>? measurementUnits;

    private async Task ReloadGrid()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            string uri = "measurementunits";
            measurementUnits = await HttpClient.GetFromJsonAsync<IEnumerable<MeasurementUnitViewModel>>(uri);
        }
        catch (HttpRequestException)
        {
            await DialogService.ShowErrorAsync("Errore durante il caricamento dei dati. Riprova.");
            measurementUnits = Array.Empty<MeasurementUnitViewModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadGrid();
    }

    private async Task CreateButtonClick()
    {
        MeasurementUnitInputModel model = new();
        DialogContent content = new();
        DialogParameters parameters = new()
            {
                Title = $"Creazione Unità di misura",
                PreventDismissOnOverlayClick = true,
                PreventScroll = true
            };

        var dialog = await DialogService.ShowDialogAsync<MeasurementUnitEditDialog>(content, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
            await ReloadGrid();
    }

    private async Task EditButtonClick(MeasurementUnitViewModel context)
    {
        MeasurementUnitInputModel model = new();
        DialogContent content = new() { Id = context.Id };
        DialogParameters parameters = new()
            {
                Title = $"Modifica Unità di misura",
                PreventDismissOnOverlayClick = true,
                PreventScroll = true
            };

        var dialog = await DialogService.ShowDialogAsync<MeasurementUnitEditDialog>(content, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
            await ReloadGrid();
    }

    private async Task DeleteButtonClick(MeasurementUnitViewModel context)
    {
        var dialog = await DialogService.ShowConfirmationAsync("Sei sicuro di voler eliminare questo elemento?", "Sì", "No", "Eliminazione");
        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        string uri = $"measurementunits/{context.Id}";
        var response = await HttpClient.DeleteAsync(uri);
        if (!response.IsSuccessStatusCode)
        {
            await DialogService.ShowResponseErrorAsync(response);
            return;
        }

        await ReloadGrid();
    }
}
