@using Gdn.Web.Fluentblazor.Models.Payments
@implements IDialogContentComponent<InvoiceEditModel>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.Money())" />
        <FluentLabel Typo="Typography.PaneHeader">Registra pagamento</FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    <EditForm EditContext="EditContext" FormName="payment-form">
        <DataAnnotationsValidator />
        <FluentGrid Spacing="1">
            <FluentGridItem xs="12" sm="6">
                <FluentDatePicker @bind-Value="Payment.DateWithTime" Label="Data pagamento"
                                  Required="true" Style="width: 100%" />
            </FluentGridItem>
            <FluentGridItem xs="12" sm="6">
                <FluentDecimalField Label="Importo" @bind-DecimalValue="Payment.Amount"
                                    Style="width: 100%" />
                <FluentLabel Typo="Typography.Body" Style="font-size: 0.8rem; color: var(--neutral-foreground-hint);">
                    Residuo totale: @TotalRemaining.ToString("C2")
                </FluentLabel>
            </FluentGridItem>
            <FluentGridItem xs="12">
                <FluentCombobox Items="@PaymentMethods"
                                TOption="PaymentMethodViewModel"
                                SelectedOption="SelectedPaymentMethod"
                                SelectedOptionChanged="o => { SelectedPaymentMethod = o; Payment.PaymentMethodId = o?.Id; }"
                                OptionText="@(e => e?.Name)"
                                Label="Metodo di pagamento"
                                Height="200px" Width="100%"
                                Autocomplete="ComboboxAutocomplete.Both" />
            </FluentGridItem>
        </FluentGrid>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Style="margin-top: 8px;">
                @ErrorMessage
            </FluentMessageBar>
        }
    </EditForm>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@SaveAsync" Disabled="@IsSaving">
        Salva
    </FluentButton>
</FluentDialogFooter>

@code {
    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;

    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    [Parameter] public InvoiceEditModel Content { get; set; } = default!;

    private HttpClient HttpClient => HttpClientFactory.CreateApiClientVs();
    private PaymentInputModel Payment { get; set; } = new();
    private EditContext EditContext { get; set; } = default!;
    private IEnumerable<PaymentMethodViewModel>? PaymentMethods;
    private PaymentMethodViewModel? SelectedPaymentMethod;
    private string? ErrorMessage;
    private bool IsSaving;

    // Sorted unpaid dues — allocation order is oldest-first.
    private List<PaymentAllocationModel> UnpaidDues { get; set; } = [];
    private decimal TotalRemaining => UnpaidDues.Sum(d => d.DueRemainingAmount);

    protected override async Task OnInitializedAsync()
    {
        EditContext = new EditContext(Payment);

        UnpaidDues = Content.Dues
            .Where(d => !d.IsPaid)
            .OrderBy(d => d.Date)
            .Select(d => new PaymentAllocationModel
            {
                DueId = d.Id!.Value,
                DueDate = d.Date,
                DueAmount = d.Amount,
                DuePaidAmount = d.PaidAmount
            })
            .ToList();

        Payment.Amount = TotalRemaining;

        PaymentMethods = await HttpClient.GetFromJsonAsync<IEnumerable<PaymentMethodViewModel>>("paymentmethods")
            ?? Enumerable.Empty<PaymentMethodViewModel>();
    }

    private async Task SaveAsync()
    {
        ErrorMessage = null;

        if (!EditContext.Validate())
            return;

        // Allocate FIFO: oldest due first, fill up to its remaining balance.
        var allocations = ComputeAllocations(Payment.Amount, UnpaidDues);

        if (allocations.Count == 0)
        {
            ErrorMessage = "Nessuna scadenza da saldare.";
            return;
        }

        var request = new
        {
            Payment.Date,
            Payment.Amount,
            Payment.PaymentMethodId,
            Allocations = allocations.Select(a => new { a.DueId, a.Amount })
        };

        IsSaving = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("payments", request);
            if (response.IsSuccessStatusCode)
                await Dialog.CloseAsync(true);
            else
                ErrorMessage = "Errore durante il salvataggio del pagamento.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    /// <summary>
    /// Distributes <paramref name="paymentAmount"/> across <paramref name="dues"/> in date order
    /// (oldest first), capping each allocation at the due''s remaining balance.
    /// </summary>
    private static List<PaymentAllocationModel> ComputeAllocations(
        decimal paymentAmount, IEnumerable<PaymentAllocationModel> dues)
    {
        var result = new List<PaymentAllocationModel>();
        var remaining = paymentAmount;

        foreach (var due in dues)
        {
            if (remaining <= 0)
                break;

            var allocated = Math.Min(remaining, due.DueRemainingAmount);
            if (allocated > 0)
            {
                result.Add(new PaymentAllocationModel { DueId = due.DueId, Amount = allocated });
                remaining -= allocated;
            }
        }

        return result;
    }
}
