@* Hiding entries by role is only about keeping the menu relevant. The enforcement lives on the
   server: this code is downloadable, so it can never be the real gate. *@

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Panoramica
    </MudNavLink>

    <AuthorizeView Roles="@UserRoles.Admin">
        <MudNavLink Href="/invoices" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
            Fatture
        </MudNavLink>
        <MudNavLink Href="/creditnotes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
            Note di credito
        </MudNavLink>
    </AuthorizeView>

    <MudNavLink Href="/interventions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">
        Rapporti di intervento
    </MudNavLink>

    <AuthorizeView Roles="@UserRoles.Admin">
        <MudNavLink Href="/quotes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RequestQuote">
            Preventivi
        </MudNavLink>
        <MudNavLink Href="/receipts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payments">
            Pagamenti
        </MudNavLink>
    </AuthorizeView>

    <MudNavGroup Title="Anagrafiche" Icon="@Icons.Material.Filled.TableChart" Expanded="true">
        <MudNavLink Href="/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
            Clienti
        </MudNavLink>
        <MudNavLink Href="/taxrates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Percent">
            Aliquote IVA
        </MudNavLink>
        <MudNavLink Href="/measurementunits" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Straighten">
            Unità di misura
        </MudNavLink>
        <MudNavLink Href="/paymentmethods" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payment">
            Metodi di pagamento
        </MudNavLink>
        <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
            Prodotti/Servizi
        </MudNavLink>
        <MudNavLink Href="/productcategories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">
            Categorie prodotti
        </MudNavLink>
    </MudNavGroup>

    <AuthorizeView Roles="@UserRoles.Admin">
        <MudNavGroup Title="Amministrazione" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
                Utenti
            </MudNavLink>
            <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                Impostazioni
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>
