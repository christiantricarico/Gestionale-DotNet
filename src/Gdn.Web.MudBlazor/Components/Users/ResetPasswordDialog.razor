@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm EditContext="_editContext" id="reset-password-form" OnValidSubmit="@SaveAsync">
            <DataAnnotationsValidator />

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                La nuova password sostituisce quella attuale di <b>@_model.Email</b>. Tutte le sessioni
                aperte di questo utente vengono chiuse.
            </MudText>

            <MudTextField @bind-Value="_model.Password"
                          For="@(() => _model.Password)"
                          Label="Nuova password"
                          InputType="InputType.Password"
                          FullWidth="true"
                          Class="mb-3" />

            <MudTextField @bind-Value="_model.ConfirmPassword"
                          For="@(() => _model.ConfirmPassword)"
                          Label="Conferma password"
                          InputType="InputType.Password"
                          FullWidth="true" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_saving">Annulla</MudButton>
        <MudButton ButtonType="ButtonType.Submit"
                   form="reset-password-form"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@_saving">Salva</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public ResetPasswordModel _model { get; set; } = new();

    private EditContext _editContext = default!;
    private bool _saving;

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            var response = await Http.PutAsJsonAsync("users/password", new { _model.Id, _model.Password });

            if (!await Snackbar.ShowResponseErrorAsync(response))
                return;

            Snackbar.Add("Password aggiornata.", Severity.Success);
            Dialog.Close();
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
