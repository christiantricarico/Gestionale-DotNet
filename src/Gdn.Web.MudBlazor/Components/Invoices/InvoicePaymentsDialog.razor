@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Fattura @Invoice.Number &mdash; @Invoice.CustomerName</MudText>
                <MudText Typo="Typo.caption">@Invoice.Date.ToString("d")</MudText>
            </MudStack>
            <MudSpacer />
            <MudChip T="string" Color="@GetStatusColor(PaymentStatus)" Size="Size.Small">@PaymentStatus</MudChip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                <MudProgressCircular Indeterminate="true" />
            </MudStack>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle1">Scadenze</MudText>
                <MudSpacer />
                @if (_dues.Any(d => !d.IsPaid))
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="RegisterPaymentClickAsync">
                        Registra pagamento
                    </MudButton>
                }
            </MudStack>

            <MudStack Spacing="2" Class="mb-4">
                @foreach (var due in _dues)
                {
                    <MudCard>
                        <MudCardContent Class="pa-3">
                            <MudGrid>
                                <MudItem xs="6" sm="3">
                                    <MudText Typo="Typo.caption">Scadenza</MudText>
                                    <MudText>@due.Date.ToString("d")</MudText>
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudText Typo="Typo.caption">Importo</MudText>
                                    <MudText>@due.Amount.ToString("C2")</MudText>
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudText Typo="Typo.caption">Pagato</MudText>
                                    <MudText>@due.PaidAmount.ToString("C2")</MudText>
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudText Typo="Typo.caption">Residuo</MudText>
                                    <MudText><strong>@((due.Amount - due.PaidAmount).ToString("C2"))</strong></MudText>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudChip T="string" Color="@GetStatusColor(due.Status)" Size="Size.Small">@due.Status</MudChip>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle1" Class="mb-3">Pagamenti registrati</MudText>

            @if (_payments.Count == 0)
            {
                <MudAlert Severity="Severity.Info">Nessun pagamento registrato per questa fattura.</MudAlert>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var payment in _payments)
                    {
                        <MudCard>
                            <MudCardContent Class="pa-3">
                                <MudGrid>
                                    <MudItem xs="6" sm="2">
                                        <MudText Typo="Typo.caption">Data</MudText>
                                        <MudText>@payment.Date.ToString("d")</MudText>
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudText Typo="Typo.caption">Importo</MudText>
                                        <MudText>@payment.Amount.ToString("C2")</MudText>
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudText Typo="Typo.caption">Metodo</MudText>
                                        <MudText>@(payment.PaymentMethodName ?? "—")</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption">Allocazioni</MudText>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                            @foreach (var a in payment.Allocations)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                    Sc. @a.DueDate.ToString("dd/MM") &mdash; @a.AllocationAmount.ToString("C2")
                                                </MudChip>
                                            }
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" sm="1" Class="d-flex justify-end">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => DeletePaymentClickAsync(payment))" />
                                    </MudItem>
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudStack>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public InvoiceViewModel Invoice { get; set; } = default!;

    private bool _isLoading = true;
    private bool _hasChanges;
    private List<InvoiceDueViewModel> _dues = [];
    private List<PaymentHistoryViewModel> _payments = [];
    private string PaymentStatus { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var invoiceDetail = await Http.GetFromJsonAsync<InvoiceEditModel>($"invoices/{Invoice.Id}");

        _dues = invoiceDetail?.Dues
            .Select(d => new InvoiceDueViewModel
            {
                Id = d.Id!.Value,
                Date = d.Date,
                Amount = d.Amount,
                PaidAmount = d.PaidAmount,
                IsPaid = d.IsPaid
            })
            .OrderBy(d => d.Date)
            .ToList() ?? [];

        _payments = await Http.GetFromJsonAsync<List<PaymentHistoryViewModel>>($"invoices/{Invoice.Id}/payments") ?? [];

        PaymentStatus = _dues switch
        {
            [] => "Non pagata",
            _ when _dues.All(d => d.IsPaid) => "Pagata",
            _ when _dues.Any(d => d.PaidAmount > 0) => "Parzialmente pagata",
            _ => "Non pagata"
        };

        _isLoading = false;
    }

    private async Task RegisterPaymentClickAsync()
    {
        var invoiceForPayment = await Http.GetFromJsonAsync<InvoiceEditModel>($"invoices/{Invoice.Id}");
        if (invoiceForPayment is null)
            return;

        var dues = invoiceForPayment.Dues.Where(d => !d.IsPaid).OrderBy(d => d.Date).ToList();

        var parameters = new DialogParameters<PaymentDialog>();
        parameters.Add(x => x.InvoiceId, Invoice.Id);
        parameters.Add(x => x.Dues, dues);
        var options = new DialogOptions { CloseOnEscapeKey = false, CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dlg = await DialogService.ShowAsync<PaymentDialog>($"Registra pagamento — Fattura {Invoice.Number}", parameters, options);
        if (!(await dlg.Result)!.Canceled)
        {
            _hasChanges = true;
            await LoadDataAsync();
        }
    }

    private async Task DeletePaymentClickAsync(PaymentHistoryViewModel payment)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Eliminazione",
            "Sei sicuro di voler eliminare questo pagamento?",
            yesText: "Sì", cancelText: "No");
        if (confirmed is not true)
            return;

        var response = await Http.DeleteAsync($"payments/{payment.Id}");
        if (!await Snackbar.ShowResponseErrorAsync(response))
            return;

        _hasChanges = true;
        await LoadDataAsync();
    }

    private void Close() => Dialog.Close(DialogResult.Ok(_hasChanges));

    private static Color GetStatusColor(string status) => status switch
    {
        "Pagata" => Color.Success,
        "Parzialmente pagata" => Color.Warning,
        _ => Color.Default
    };
}
