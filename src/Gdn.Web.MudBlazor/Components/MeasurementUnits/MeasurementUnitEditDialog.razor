@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Straighten" Class="mr-2" />
            @(_content.Id > 0 ? "Modifica unità di misura" : "Nuova unità di misura")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm id="measurementUnitForm" Model="@_model" OnValidSubmit="@SaveAsync">
            <DataAnnotationsValidator />
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.Code"
                                  Label="Codice"
                                  Variant="Variant.Outlined"
                                  MaxLength="10"
                                  For="@(() => _model.Code)" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Nome"
                                  Variant="Variant.Outlined"
                                  MaxLength="255"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Descrizione"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  For="@(() => _model.Description)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Annulla</MudButton>
        <MudButton ButtonType="ButtonType.Submit"
                   form="measurementUnitForm"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Salva
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public DialogContent _content { get; set; } = new();

    private MeasurementUnitInputModel _model = new();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (_content.Id > 0)
        {
            var response = await Http.GetAsync($"measurementunits/{_content.Id}");
            if (await Snackbar.ShowResponseErrorAsync(response))
            {
                var data = await response.Content.ReadFromJsonAsync<MeasurementUnitViewModel>();
                if (data is not null)
                {
                    _model.Code = data.Code;
                    _model.Name = data.Name;
                    _model.Description = data.Description;
                }
            }
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;

        HttpResponseMessage response;

        if (_content.Id > 0)
        {
            response = await Http.PutAsJsonAsync("measurementunits", new { _content.Id, _model.Code, _model.Name, _model.Description });
        }
        else
        {
            response = await Http.PostAsJsonAsync("measurementunits", new { _model.Code, _model.Name, _model.Description });
        }

        _saving = false;

        if (await Snackbar.ShowResponseErrorAsync(response))
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }
}
