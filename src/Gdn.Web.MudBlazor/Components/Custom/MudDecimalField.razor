@namespace Gdn.Web.MudBlazor.Components.Custom

<MudTextField T="string"
              Value="@StringValue"
              ValueChanged="@OnValueChanged"
              Label="@Label"
              Disabled="@Disabled"
              Class="@ComputedClass"
              InputType="InputType.Text" />

@code {
    [Parameter] public decimal DecimalValue { get; set; }
    [Parameter] public EventCallback<decimal> DecimalValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ComputedClass => FullWidth
        ? $"mud-width-full {Class}".Trim()
        : Class ?? string.Empty;

    private string StringValue => DecimalValue.ToString("n2");

    private async Task OnValueChanged(string? value)
    {
        var decimalValue = UIUtils.ConvertTextToDecimal(value);
        await DecimalValueChanged.InvokeAsync(decimalValue);
    }
}
