@page "/users"
@attribute [Authorize(Roles = UserRoles.Admin)]

@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Utenti</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Utenti</MudText>
        <MudSpacer />
        @if (!_isLoading)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateButtonClick">Nuovo</MudButton>
        }
    </MudStack>

    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string"
                          Label="Filtro"
                          Value="@_filterText"
                          ValueChanged="OnFilterTextChanged"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        @foreach (var item in _filteredItems)
        {
            <MudCard Class="mb-2">
                <MudCardContent Class="pa-3">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption">Email</MudText>
                            <MudText>@item.Email</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText Typo="Typo.caption">Nome</MudText>
                            <MudText>@item.FullName</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.caption">Ruolo</MudText>
                            <MudText>@RoleLabel(item.Role)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="1">
                            <MudText Typo="Typo.caption">Stato</MudText>
                            @if (!item.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Disattivo</MudChip>
                            }
                            else if (item.IsLockedOut)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Bloccato</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Attivo</MudChip>
                            }
                        </MudItem>
                        <MudItem xs="12" sm="2" Class="d-flex justify-end align-center gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Password"
                                           Size="Size.Small"
                                           title="Cambia password"
                                           OnClick="@(() => ResetPasswordButtonClick(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           OnClick="@(() => EditButtonClick(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteButtonClick(item))" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        }
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private IEnumerable<UserViewModel> _items = [];
    private List<UserViewModel> _filteredItems = [];
    private string _filterText = string.Empty;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _items = await Http.GetFromJsonAsync<IEnumerable<UserViewModel>>("users") ?? [];
            ApplyFilter();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Errore durante il caricamento dei dati.", Severity.Error);
            _items = [];
            ApplyFilter();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateButtonClick()
    {
        var parameters = new DialogParameters<UserEditDialog>();
        parameters.Add(x => x._content, new DialogContent());

        var dialog = await DialogService.ShowAsync<UserEditDialog>("Nuovo utente", parameters, DialogOptions());
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await ReloadAsync();
    }

    private async Task EditButtonClick(UserViewModel item)
    {
        var parameters = new DialogParameters<UserEditDialog>();
        parameters.Add(x => x._content, new DialogContent { Id = item.Id });

        var dialog = await DialogService.ShowAsync<UserEditDialog>("Modifica utente", parameters, DialogOptions());
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await ReloadAsync();
    }

    private async Task ResetPasswordButtonClick(UserViewModel item)
    {
        var parameters = new DialogParameters<ResetPasswordDialog>();
        parameters.Add(x => x._model, new ResetPasswordModel { Id = item.Id, Email = item.Email });

        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>("Cambia password", parameters, DialogOptions());
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await ReloadAsync();
    }

    private async Task DeleteButtonClick(UserViewModel item)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Eliminazione",
            $"Sei sicuro di voler eliminare l'utente {item.Email}?",
            yesText: "Sì", cancelText: "No");

        if (confirmed is not true)
            return;

        var response = await Http.DeleteAsync($"users/{item.Id}");
        if (!await Snackbar.ShowResponseErrorAsync(response))
            return;

        await ReloadAsync();
    }

    private static DialogOptions DialogOptions() => new()
    {
        CloseOnEscapeKey = false,
        CloseButton = false,
        BackdropClick = false,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    private static string RoleLabel(string role) => role == UserRoles.Admin ? "Amministratore" : "Collaboratore";

    private void OnFilterTextChanged(string? value)
    {
        _filterText = value ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredItems = string.IsNullOrWhiteSpace(_filterText)
            ? [.. _items]
            : [.. _items.Where(item => ContainsText(item.Email) || ContainsText(item.FullName))];
    }

    private bool ContainsText(string? value) =>
        value?.Contains(_filterText, StringComparison.OrdinalIgnoreCase) is true;
}
